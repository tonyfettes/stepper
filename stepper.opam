opam-version: "2.0"
synopsis: "Reference implementation of stack-based stepping filters"
maintainer: "Stepper maintainers"
authors: "Stepper contributors"
depends: [
  "ocaml" {>= "4.13"}
  "dune" {>= "3.0"}
  "qcheck-core" {with-test & >= "0.91"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
